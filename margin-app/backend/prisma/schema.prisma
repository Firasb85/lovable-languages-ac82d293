generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  businessName    String
  sector          String
  businessAge     Int
  location        String
  phone           String?
  subscriptionTier String   @default("free")
  reportCount     Int      @default(0)
  maxReports      Int      @default(3)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reports         Report[]
  payments        Payment[]
  subscriptions   Subscription[]
}

model Report {
  id              String    @id @default(cuid())
  title           String
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  sector          String
  businessName    String
  businessAge     Int
  location        String
  overallScore    Int
  riskLevel       String
  axisScores      String
  diagnosis        String
  actionableDecisions String
  ninetyDayPlan    String
  sectorComparison String
  wishText        String
  answers         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Action {
  id              String    @id @default(cuid())
  reportId        String
  report          Report   @relation(fields: [reportId], references: [id])
  axis            String
  title           String
  description     String
  priority        String   @default("medium")
  impact          String   @default("medium")
  effort          String   @default("medium")
  timeline        String
  steps           String
  completed       Boolean  @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Plan {
  id              String    @id @default(cuid())
  reportId        String
  report          Report   @relation(fields: [reportId], references: [id])
  title           String
  description     String
  monthlyGoals    String
  successMetrics  String
  resourcesNeeded String
  estimatedCost   String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  tier            String
  amount          Int
  currency        String   @default("IQD")
  paymentMethod   String
  phone           String
  status          String   @default("pending")
  metadata        String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  subscription    Subscription?
}

model Subscription {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  tier            String
  paymentId       String?
  payment         Payment?  @relation(fields: [paymentId], references: [id])
  amount          Int
  startDate       DateTime  @default(now())
  endDate         DateTime
  status          String   @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}